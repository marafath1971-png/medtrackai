rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: Is the caller an active caregiver of this user? ────────
    // The `caregivers` roster is keyed by the numeric cgId, but a rule can only
    // get() a document by a known path — it cannot query for the slot whose
    // joinedCaregiverUid matches the caller. Reading that roster by uid could
    // therefore never match, and every caregiver read was silently denied.
    // Activation writes a uid-keyed grant under caregiverAccess; that is what
    // this reads.
    function isActiveCaregiver(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)/caregiverAccess/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(userId)/caregiverAccess/$(request.auth.uid)).data.status == 'active';
    }

    // ── Helper: Is an invite code still within its 24-hour window? ─────
    //
    // resource is null when the document does not exist, and dereferencing
    // resource.data on a null resource denies the read rather than returning
    // "not found". Creating an invite probes up to five candidate codes for
    // collisions, so the common case — the code is free — was the case that
    // failed, and every invite creation died in the uniqueness check.
    function isInviteValid() {
      return resource != null
        && resource.data.createdAt != null
        && request.time < resource.data.createdAt + duration.value(86400, 's');
    }

    // A caller may probe whether a code is taken. The probe reveals only
    // existence, never contents, because a missing document has none.
    function isOwnInvite() {
      return resource != null && resource.data.patientUid == request.auth.uid;
    }

    // ── Helper: Has this user let the caller see their steps? ──────────
    // A grant at users/{userId}/stepPartners/{callerUid} is the whole test;
    // unpairing deletes it. Deliberately separate from caregiverAccess: a
    // walking partner sees step counts and nothing else.
    function isStepPartner(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)/stepPartners/$(request.auth.uid));
    }

    // ── Helper: Is the caller redeeming a live step invite from this user? ─
    // The grant being created must name the invite it came from, and that
    // invite must belong to the user whose steps are being opened up and
    // still be inside its 24 hours. get() reads the invite as it was before
    // the write, so the same batch can delete it.
    function redeemsStepInvite(userId) {
      let code = request.resource.data.get('inviteCode', '');
      let path = /databases/$(database)/documents/stepInvites/$(code);
      return code is string && code.size() == 6
        && exists(path)
        && get(path).data.ownerUid == userId
        && request.time < get(path).data.createdAt + duration.value(86400, 's');
    }

    // ── User Data (Owner & Caregiver access) ──────────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && isActiveCaregiver(userId);

      match /medicines/{medId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow read: if request.auth != null && isActiveCaregiver(userId);
      }

      match /history/{dateKey} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow read: if request.auth != null && isActiveCaregiver(userId);
      }

      match /caregivers/{cgKey} {
        allow read: if request.auth != null && (request.auth.uid == userId || request.auth.uid == cgKey);
        allow delete: if request.auth != null && (request.auth.uid == userId || request.auth.uid == cgKey);
        // Patient manages roster; caregiver may activate their own slot after joining via invite.
        allow create, update: if request.auth != null && (
          request.auth.uid == userId
          || request.resource.data.get('joinedCaregiverUid', '') == request.auth.uid
        );
      }

      // Access grants, keyed by caregiver uid. A caregiver may create their own
      // grant when redeeming an invite; only the patient may revoke. The grant
      // carries no patient data — it exists solely so isActiveCaregiver() has a
      // document it can address by path.
      match /caregiverAccess/{caregiverUid} {
        allow read: if request.auth != null
                    && (request.auth.uid == userId
                        || request.auth.uid == caregiverUid);
        allow create, update: if request.auth != null && (
          (request.auth.uid == caregiverUid && request.resource.data.status == 'active')
          || request.auth.uid == userId
        );
        allow delete: if request.auth != null
                      && (request.auth.uid == userId
                          || request.auth.uid == caregiverUid);
      }

      // Monitoring List: Owned by the caregiver to track their patients
      match /monitoring/{patientId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Recursive rule for sub-paths in monitoring if needed
      match /monitoring/{allPaths=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /symptoms/{symptomId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow read: if request.auth != null && isActiveCaregiver(userId);
      }

      // ── Steps ────────────────────────────────────────────────────────
      //
      // Daily totals. The owner writes; a walking partner reads. Caregivers
      // are deliberately not included — pairing for steps and watching
      // someone's medication are separate consents.
      match /stepDays/{dateKey} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow read: if request.auth != null && isStepPartner(userId);
      }

      // Grants: users/{userId}/stepPartners/{partnerUid} lets partnerUid read
      // userId's stepDays. The owner can always grant and revoke on their own
      // data. Anyone else can create a grant for themselves only by redeeming
      // an invite the owner issued — without that check any signed-in user
      // could open up any other user's step history.
      match /stepPartners/{partnerUid} {
        allow read: if request.auth != null
                    && (request.auth.uid == userId
                        || request.auth.uid == partnerUid);
        allow create, update: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
                      && request.auth.uid == partnerUid
                      && request.resource.data.keys().hasOnly(
                           ['uid', 'name', 'avatar', 'inviteCode', 'since'])
                      && request.resource.data.uid == partnerUid
                      && request.resource.data.name is string
                      && request.resource.data.name.size() <= 60
                      && redeemsStepInvite(userId);
        // Either side can end it.
        allow delete: if request.auth != null
                      && (request.auth.uid == userId
                          || request.auth.uid == partnerUid);
      }

      // Cheers and nudges from a partner. The shape is pinned so this cannot
      // become a channel for arbitrary text, and only the recipient can read
      // or clear them.
      match /stepCheers/{cheerId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
                      && isStepPartner(userId)
                      && request.resource.data.keys().hasOnly(
                           ['fromUid', 'kind', 'createdAt'])
                      && request.resource.data.fromUid == request.auth.uid
                      && request.resource.data.kind in ['cheer', 'nudge']
                      && request.resource.data.createdAt == request.time;
      }

      // ── Dependent profiles (family members) ─────────────────────────
      //
      // The app manages schedules for children and elderly relatives under
      // users/{uid}/dependents/{profileId}, mirroring the owner's own layout.
      // Rules do not cascade into subcollections, so without these blocks the
      // catch-all `allow read, write: if false` at the bottom denied every
      // dependent read and write — the caregiver persona's entire dataset.
      //
      // Permissions deliberately mirror the owner's own collections above: a
      // dependent is the owner's data, not a separate principal, and an
      // active caregiver watching the account can read it but never write.
      //
      // The parent doc holds the dependent's `takenToday` map (written by
      // FirestoreDataSource.saveTakenToday, which is what creates the doc at
      // all — it is absent until a dose is logged).
      match /dependents/{profileId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow read: if request.auth != null && isActiveCaregiver(userId);

        match /medicines/{medId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
          allow read: if request.auth != null && isActiveCaregiver(userId);
        }

        match /history/{dateKey} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
          allow read: if request.auth != null && isActiveCaregiver(userId);
        }

        match /symptoms/{symptomId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
          allow read: if request.auth != null && isActiveCaregiver(userId);
        }
      }
    }

    // ── Caregiver Invites ───────────────────────────────────────────────
    match /caregiverInvites/{inviteCode} {
      // A non-existent code reads as empty, which is what the uniqueness
      // probe needs; a live code reads for the caregiver redeeming it; and
      // the patient can always read back their own.
      allow read:   if request.auth != null && (isInviteValid() || isOwnInvite() || resource == null);

      // The payload shape is pinned rather than merely conventional. This
      // document is readable by anyone holding the code — including someone
      // with no relationship to the patient — so an identifying field added
      // here later would be exposed to them. hasOnly() makes that a rejected
      // write instead of a silent leak, and createdAt is forced to
      // request.time so the 24-hour window cannot be backdated.
      allow create: if request.auth != null
                    && request.resource.data.patientUid == request.auth.uid
                    && request.resource.data.keys().hasOnly(
                         ['patientUid', 'cgId', 'relation', 'createdAt'])
                    && request.resource.data.createdAt == request.time;

      // No update clause: invites are immutable, and reissuing means a new
      // code.
      //
      // Deletion is the patient revoking, or the caregiver consuming the
      // invite once their access grant exists. The previous `|| isInviteValid()`
      // was true of every pending invite, so ANY signed-in user could delete
      // ANY live invite and silently break a stranger's onboarding.
      allow delete: if request.auth != null && (
        resource.data.patientUid == request.auth.uid
        || isActiveCaregiver(resource.data.patientUid)
      );
    }

    // ── Step partner invites ────────────────────────────────────────────
    //
    // Same model as caregiverInvites: a 6-character code, readable by whoever
    // holds it for 24 hours, naming only its owner. The shape is pinned for
    // the same reason — a name here would be shown to anyone who guesses a
    // code.
    match /stepInvites/{inviteCode} {
      allow read: if request.auth != null && (
        resource == null
        || resource.data.ownerUid == request.auth.uid
        || request.time < resource.data.createdAt + duration.value(86400, 's')
      );
      allow create: if request.auth != null
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.keys().hasOnly(['ownerUid', 'createdAt'])
                    && request.resource.data.createdAt == request.time;
      // The owner withdrawing it, or the redeemer consuming it — which is
      // only true once their grant exists, checked against the state after
      // the batch that creates both.
      allow delete: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid
        || existsAfter(/databases/$(database)/documents/users/$(resource.data.ownerUid)/stepPartners/$(request.auth.uid))
      );
    }

    // ── Missed-dose escalation records ──────────────────────────────────
    //
    // Written only by Cloud Functions (detectMissedDoses creates and extends
    // them, acknowledgeMissedDose claims them), so clients never write. Each
    // names a patient's medicine, so reads are limited to the patient and to
    // the caregivers the alert actually reached — list queries included, which
    // is why this tests resource.data rather than a path segment: a caregiver
    // asks for `alertedUids array-contains me` and the rule proves every
    // returned doc satisfies it.
    match /missedDoseAlerts/{alertId} {
      allow read: if request.auth != null && (
        resource.data.patientUid == request.auth.uid
        || request.auth.uid in resource.data.alertedUids
      );
      allow write: if false;
    }

    // ── Deny everything else ────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
