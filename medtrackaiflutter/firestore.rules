rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: Is the caller an active caregiver of this user? ────────
    // The `caregivers` roster is keyed by the numeric cgId, but a rule can only
    // get() a document by a known path — it cannot query for the slot whose
    // joinedCaregiverUid matches the caller. Reading that roster by uid could
    // therefore never match, and every caregiver read was silently denied.
    // Activation writes a uid-keyed grant under caregiverAccess; that is what
    // this reads.
    function isActiveCaregiver(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)/caregiverAccess/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(userId)/caregiverAccess/$(request.auth.uid)).data.status == 'active';
    }

    // ── Helper: Is an invite code still within its 24-hour window? ─────
    //
    // resource is null when the document does not exist, and dereferencing
    // resource.data on a null resource denies the read rather than returning
    // "not found". Creating an invite probes up to five candidate codes for
    // collisions, so the common case — the code is free — was the case that
    // failed, and every invite creation died in the uniqueness check.
    function isInviteValid() {
      return resource != null
        && resource.data.createdAt != null
        && request.time < resource.data.createdAt + duration.value(86400, 's');
    }

    // A caller may probe whether a code is taken. The probe reveals only
    // existence, never contents, because a missing document has none.
    function isOwnInvite() {
      return resource != null && resource.data.patientUid == request.auth.uid;
    }

    // ── User Data (Owner & Caregiver access) ──────────────────────────
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && isActiveCaregiver(userId);

      match /medicines/{medId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow read: if request.auth != null && isActiveCaregiver(userId);
      }

      match /history/{dateKey} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow read: if request.auth != null && isActiveCaregiver(userId);
      }

      match /caregivers/{cgKey} {
        allow read: if request.auth != null && (request.auth.uid == userId || request.auth.uid == cgKey);
        allow delete: if request.auth != null && (request.auth.uid == userId || request.auth.uid == cgKey);
        // Patient manages roster; caregiver may activate their own slot after joining via invite.
        allow create, update: if request.auth != null && (
          request.auth.uid == userId
          || request.resource.data.get('joinedCaregiverUid', '') == request.auth.uid
        );
      }

      // Access grants, keyed by caregiver uid. A caregiver may create their own
      // grant when redeeming an invite; only the patient may revoke. The grant
      // carries no patient data — it exists solely so isActiveCaregiver() has a
      // document it can address by path.
      match /caregiverAccess/{caregiverUid} {
        allow read: if request.auth != null
                    && (request.auth.uid == userId
                        || request.auth.uid == caregiverUid);
        allow create: if request.auth != null
                      && request.auth.uid == caregiverUid
                      && request.resource.data.status == 'active';
        allow update: if request.auth != null && request.auth.uid == userId;
        allow delete: if request.auth != null
                      && (request.auth.uid == userId
                          || request.auth.uid == caregiverUid);
      }

      // Monitoring List: Owned by the caregiver to track their patients
      match /monitoring/{patientId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Recursive rule for sub-paths in monitoring if needed
      match /monitoring/{allPaths=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /symptoms/{symptomId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
        allow read: if request.auth != null && isActiveCaregiver(userId);
      }
    }

    // ── Caregiver Invites ───────────────────────────────────────────────
    match /caregiverInvites/{inviteCode} {
      // A non-existent code reads as empty, which is what the uniqueness
      // probe needs; a live code reads for the caregiver redeeming it; and
      // the patient can always read back their own.
      allow read:   if request.auth != null && (isInviteValid() || isOwnInvite() || resource == null);

      // The payload shape is pinned rather than merely conventional. This
      // document is readable by anyone holding the code — including someone
      // with no relationship to the patient — so an identifying field added
      // here later would be exposed to them. hasOnly() makes that a rejected
      // write instead of a silent leak, and createdAt is forced to
      // request.time so the 24-hour window cannot be backdated.
      allow create: if request.auth != null
                    && request.resource.data.patientUid == request.auth.uid
                    && request.resource.data.keys().hasOnly(
                         ['patientUid', 'cgId', 'relation', 'createdAt'])
                    && request.resource.data.createdAt == request.time;

      // No update clause: invites are immutable, and reissuing means a new
      // code.
      //
      // Deletion is the patient revoking, or the caregiver consuming the
      // invite once their access grant exists. The previous `|| isInviteValid()`
      // was true of every pending invite, so ANY signed-in user could delete
      // ANY live invite and silently break a stranger's onboarding.
      allow delete: if request.auth != null && (
        resource.data.patientUid == request.auth.uid
        || isActiveCaregiver(resource.data.patientUid)
      );
    }

    // ── Deny everything else ────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
