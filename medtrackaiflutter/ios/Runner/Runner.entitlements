<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<!-- Universal Links. Without this key iOS never fetches the association
	     file, so https://medai.app/j?code=... opens Safari instead of the app
	     and a caregiver invite cannot be redeemed. Pairs with
	     public/.well-known/apple-app-site-association, whose appID must be
	     <TeamID>.com.medtracker.medtrackaiflutter. -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:medai.app</string>
	</array>
	<!-- HealthKit. Step counting (and HealthController's vitals sync) read
	     through the `health` plugin, and HealthKit refuses every authorization
	     request from an app without this entitlement — the permission sheet
	     never appears. Pairs with NSHealthShareUsageDescription in Info.plist. -->
	<key>com.apple.developer.healthkit</key>
	<true/>
	<!-- App Group shared with MedTrackActivityWidgetExtension. AppDelegate
	     writes the widget snapshots to UserDefaults(suiteName:) under this
	     group; without the entitlement on BOTH targets that suite is private
	     to each process and the widgets only ever see their defaults. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.medtrackai</string>
	</array>
	<!-- App Attest. main.dart activates AppleAppAttestProvider() for release
	     builds, and functions/index.js sets enforceAppCheck: true globally, so
	     without this key iOS can produce no attestation token and every
	     callable (geminiProxy — i.e. every AI path) is rejected server-side.
	     Android needs no equivalent; Play Integrity is entitlement-free.

	     "production" is correct for both App Store and TestFlight builds.
	     Xcode automatically substitutes the development attestation service
	     for debug builds, so this value does not need to change per config. -->
	<key>com.apple.developer.devicecheck.appattest-environment</key>
	<string>production</string>
</dict>
</plist>
